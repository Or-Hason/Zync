# Build-time configuration for the packaged Tauri desktop build.
#
# The bundled WebView serves the frontend from a tauri:// origin and has no Vite
# proxy, so API calls must name the backend origin explicitly. The backend is
# expected to already be running locally on this port.
#
# Loopback only — never point this at a remote host: requests carry resume PII.
VITE_API_BASE=http://127.0.0.1:8000
